{
  "manifest_version": 3,
  "name": "Eco Product Finder",
  "description": "Find eco-friendly alternatives for products.",
  "version": "1.0",

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:5000/*"
  ]
}